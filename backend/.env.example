APP_NAME=stateflow
APP_ENV=development

# Free-first default. No API key required.
# Options: mock, ollama, openai
LLM_PROVIDER=mock

# Used by Ollama or OpenAI depending on LLM_PROVIDER
LLM_MODEL=llama3.2:3b

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional OpenAI
OPENAI_API_KEY=

# Persistent LangGraph checkpoint database
CHECKPOINT_DB=stateflow_checkpoints.sqlite3

# Local API
HOST=127.0.0.1
PORT=8000

# Frontend development origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Safety limits
MAX_MESSAGE_LENGTH=4000
